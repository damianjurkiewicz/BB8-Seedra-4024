        _aGCodeBuffer[79]  := 'N77 G01 Z22 F600$N';
        _aGCodeBuffer[80]  := 'N78 G01 Q1=180. F12000$N';
        _aGCodeBuffer[81]  := 'N79 G01 Z0 F400$N';
