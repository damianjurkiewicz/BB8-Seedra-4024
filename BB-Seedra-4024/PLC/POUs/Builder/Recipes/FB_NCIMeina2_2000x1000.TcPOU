        _aGCodeBuffer[58]  := 'N56 G01 Z8 F400$N';
        _aGCodeBuffer[59]  := 'N57 X286.475 F1385.71$N';
        _aGCodeBuffer[60]  := 'N58 G03 X290 Y2213.52 Q1=-0.04 I0.003 J3.522 F658.25$N';
        _aGCodeBuffer[61]  := 'N59 G01 Y2231.72 F1385.71$N';
