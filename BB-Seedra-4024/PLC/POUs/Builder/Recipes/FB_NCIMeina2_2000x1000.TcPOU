<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_NCIMeina2_2000x1000" Id="{22b8006b-85a6-4b7f-b0ea-19ab060d1e2b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_NCIMeina2_2000x1000 EXTENDS FB_RecipeBase

]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Build" Id="{fa0b89f6-ef30-4f8b-ba6b-e1f90d3f2882}">
      <Declaration><![CDATA[METHOD Build : BOOL
VAR
      i          : INT;
	  sRecipeName : STRING(255) := '\Hard Disk2\TangentialCut2.nc';
END_VAR

VAR_INST
    nBuildStep : INT;
    machineConfig : ST_GantryXYZ_Config;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Build := FALSE;

CASE nBuildStep OF
    0:
        _Busy := TRUE;
        _Done := FALSE;
        _Error := FALSE;
        _nLinesToWrite := 0;
        
        ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'Generator: Budowanie G-Code', '');
        
        THIS^.UpdateNestingLimits();
        IF NOT _Config.IsValid THEN
            ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'NCIBuilder: Walidacja nie przeszla! Ustawiam ERROR.', '');
            _Busy := FALSE;
            _Error := TRUE;
            Build := FALSE;
            RETURN;
        END_IF
        
        // --- BUFOR G-CODE ---
        _aGCodeBuffer[1]   := '(1001)$N';
        _aGCodeBuffer[2]   := 'N0 G01 Z22 F600$N';
        _aGCodeBuffer[3]   := 'N1 G01 X310 Y305 F3000$N';

        
        _nLinesToWrite := 3; 
        
        // Czyszczenie reszty bufora
        FOR i := (_nLinesToWrite + 1) TO 5 DO 
            _aGCodeBuffer[i] := '';
        END_FOR
        
        nBuildStep := 10;

    10:
      //  IF THIS^.WriteGCodeFile('\Hard Disk2\TangentialCut.nc') THEN
            ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'Generator: Zapisano plik TangentialCut.nc', '');
			 _Config.GCodePath := sRecipeName;
            nBuildStep := 1000;
      //  END_IF

    1000:
        _Busy := FALSE;
        _Done := TRUE; 
        nBuildStep := 0;
        Build := TRUE;
        
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="CalculateFootprint" Id="{9ee51b75-0294-4fb4-bca1-c4a79e66bf68}">
      <Declaration><![CDATA[METHOD PROTECTED CalculateFootprint
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_NominalX := 1;
_NominalY := 1;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExecutionRoute" Id="{2522e725-4c9d-4aa7-9745-528a8d6a0bfc}">
      <Declaration><![CDATA[PROPERTY ExecutionRoute : E_ExecutionRoute]]></Declaration>
      <Get Name="Get" Id="{c3e2079d-c741-4220-a7e8-afb21e7ed919}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecutionRoute := E_ExecutionRoute.eGCode;]]></ST>
        </Implementation>
      </Get>
    </Property>
