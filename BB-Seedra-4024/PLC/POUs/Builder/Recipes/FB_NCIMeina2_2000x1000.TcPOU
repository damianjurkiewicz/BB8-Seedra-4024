        _aGCodeBuffer[70]  := 'N68 G01 Y2310 F1212$N';
        _aGCodeBuffer[71]  := 'N69 G03 X1090 Y2410 Q1=90. I-100 F1002.57$N';
        _aGCodeBuffer[72]  := 'N70 G01 X290 F1212$N';
        _aGCodeBuffer[73]  := 'N71 G03 X190 Y2310 Q1=180. J-100 F1002.57$N';
        _aGCodeBuffer[74]  := 'N72 G01 Z22 F600$N';
