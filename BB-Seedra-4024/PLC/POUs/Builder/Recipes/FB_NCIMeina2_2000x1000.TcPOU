        _aGCodeBuffer[20]  := 'N18 G01 Q1=-180. F12000$N';
        _aGCodeBuffer[21]  := 'N19 G01 Z0 F400$N';
        _aGCodeBuffer[22]  := 'N20 Y105 F1212$N';
        _aGCodeBuffer[23]  := 'N21 G01 Z22 F600$N';
        _aGCodeBuffer[24]  := 'N22 G01 Q1=-270. F12000$N';
        _aGCodeBuffer[25]  := 'N23 G01 Z0 F400$N';
        _aGCodeBuffer[26]  := 'N24 X710 F1212$N';
        _aGCodeBuffer[27]  := 'N25 G01 Z22 F600$N';
        _aGCodeBuffer[28]  := 'N26 G01 Q1=-360. F12000$N';
        _aGCodeBuffer[29]  := 'N27 G01 Z0 F400$N';
        _aGCodeBuffer[30]  := 'N28 Y305 F1212$N';
        _aGCodeBuffer[31]  := 'N29 G01 Z22 F600$N';
        _aGCodeBuffer[32]  := 'N30 G01 Q1=-450. F12000$N';
        _aGCodeBuffer[33]  := 'N31 G01 Z0 F400$N';
        _aGCodeBuffer[34]  := 'N32 X910 F1212$N';
        _aGCodeBuffer[35]  := 'N33 Z22 F600$N';
        _aGCodeBuffer[36]  := 'N34 X290 Y588.275 F3000$N';
        _aGCodeBuffer[37]  := 'N35 G01 Q1=-360. F12000$N';
        _aGCodeBuffer[38]  := 'N36 G01 Z8 F400$N';
        _aGCodeBuffer[39]  := 'N37 Y606.475 F1385.71$N';
