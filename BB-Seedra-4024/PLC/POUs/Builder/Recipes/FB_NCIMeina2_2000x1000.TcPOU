        _aGCodeBuffer[84]  := 'N82 G01 Q1=90. F12000$N';
        _aGCodeBuffer[85]  := 'N83 G01 Z0 F400$N';
        _aGCodeBuffer[86]  := 'N84 X131 F1212$N';
        _aGCodeBuffer[87]  := 'N85 G01 Z22 F600$N';
        _aGCodeBuffer[88]  := 'N86 G01 Q1=0. F12000$N';
        _aGCodeBuffer[89]  := 'N87 G01 Z0 F400$N';
        _aGCodeBuffer[90]  := 'N88 Y2410 F1212$N';
        _aGCodeBuffer[91]  := 'N89 Z22 F600$N';
        _aGCodeBuffer[92]  := 'N90 X71 F3000$N';
        _aGCodeBuffer[93]  := 'N91 G01 Q1=-90. F12000$N';
        _aGCodeBuffer[94]  := 'N92 G01 Z0 F400$N';
        _aGCodeBuffer[95]  := 'N93 X100 F1212$N';
        _aGCodeBuffer[96]  := 'N94 G01 Z22 F600$N';
        _aGCodeBuffer[97]  := 'N95 G01 Q1=-180. F12000$N';
        _aGCodeBuffer[98]  := 'N96 G01 Z0 F400$N';
        _aGCodeBuffer[99]  := 'N97 Y1610 F1212$N';
        _aGCodeBuffer[100] := 'N98 G01 Z22 F600$N';
        _aGCodeBuffer[101] := 'N99 G01 Q1=-270. F12000$N';
        _aGCodeBuffer[102] := 'N100 G01 Z0 F400$N';
        _aGCodeBuffer[103] := 'N101 X71 F1212$N';
        _aGCodeBuffer[104] := 'N102 G01 Z22 F600$N';
        _aGCodeBuffer[105] := 'N103 G01 Q1=-360. F12000$N';
        _aGCodeBuffer[106] := 'N104 G01 Z0 F400$N';
        _aGCodeBuffer[107] := 'N105 Y2410 F1212$N';
        _aGCodeBuffer[108] := 'N106 Z22 F600$N';
        
        _nLinesToWrite := 108; 
        
        // Czyszczenie reszty bufora
        FOR i := (_nLinesToWrite + 1) TO 500 DO 
            _aGCodeBuffer[i] := '';
        END_FOR
        
        nBuildStep := 10;

    10:
        IF THIS^.WriteGCodeFile('TangentialCut.nc') THEN
            ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'Generator: Zapisano plik TangentialCut.nc', '');
            nBuildStep := 1000;
        END_IF

    1000:
        _Busy := FALSE;
        _Done := TRUE; 
        nBuildStep := 0;
        Build := TRUE;
        
END_CASE]]></ST>
      </Implementation>
