    <Method Name="Build" Id="{a9c31ce6-ed3e-43ff-bafc-85dc97fdd881}">
      <Declaration><![CDATA[METHOD Build : BOOL
VAR
      i          : INT;
END_VAR

VAR_INST
    nBuildStep : INT;
    machineConfig : ST_GantryXYZ_Config;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Done := FALSE;
_Error := FALSE;

IF LEN(_Config.GCodePath) > 0 THEN
    _Config.IsValid := TRUE;
    _Done           := TRUE;
    Build           := TRUE;
ELSE
    _Config.IsValid := FALSE;
    _Error          := TRUE;
    Build           := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExecutionRoute" Id="{e6277044-3ac9-41ce-80fb-2e38121afadb}">
