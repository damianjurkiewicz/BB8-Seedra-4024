  <POU Name="FB_GCodeUSB" Id="{fccba36f-1e04-4dd4-8f5d-37009967fb17}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCodeUSB EXTENDS FB_RecipeBase

