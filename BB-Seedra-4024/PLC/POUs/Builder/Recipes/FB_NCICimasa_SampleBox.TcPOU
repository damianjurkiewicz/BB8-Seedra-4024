<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_NCICimasa_SampleBox" Id="{e495bbc6-186b-41e3-b55e-5390c6a836f8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_NCICimasa_SampleBox EXTENDS FB_RecipeBase

]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Build" Id="{aa1e595f-ced9-4a60-89fc-140c3e1dd111}">
      <Declaration><![CDATA[METHOD Build : BOOL
VAR
END_VAR
VAR_INST
    nBuildStep : INT;
    machineConfig : ST_GantryXYZ_Config;
    
    // Zmienne do obsługi kopiowania
    fbFileCopy : FB_FileCopy;
    sUsbPath   : STRING(255) := '\Hard Disk2\vrg_flash\Cimasa_SampleBox.nc';
    sPlcPath   : STRING(255) := '\Hard Disk\GCode\Cimasa_SampleBox.nc';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Build := FALSE;

CASE nBuildStep OF
    0:
        _Busy := TRUE;
        _Done := FALSE;
        _Error := FALSE;
        
        // Rozpoczęcie kopiowania z pendrive'a (Hard Disk2) na dysk PLC
        fbFileCopy(
            sSrcPathName  := sUsbPath,
            sDestPathName := sPlcPath,
            bExecute      := TRUE
        );
        
        nBuildStep := 10;

    10:
        fbFileCopy(bExecute := FALSE); // Opuszczenie flagi Execute
        
        // Oczekiwanie na zakończenie pracy bloku kopiującego
        IF NOT fbFileCopy.bBusy THEN
            IF fbFileCopy.bError THEN
                // Błąd kopiowania (np. brak USB lub pliku) - logujemy i idziemy dalej
                ADSLOGSTR(ADSLOG_MSGTYPE_WARN, 'Brak pliku Cimasa na USB. Uzywam wersji z dysku PLC.', '');
            ELSE
                // Sukces - plik został nadpisany nową wersją z USB
                ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'Plik CimasaSampleBox.nc zostal zaktualizowany z USB.', '');
            END_IF
            
            // Niezależnie od wyniku (błąd czy sukces), recepta wskazuje na plik lokalny
            _Config.GCodePath := sPlcPath; 
            
            nBuildStep := 1000;
        END_IF

    1000:
        _Busy := FALSE;
        _Done := TRUE; 
        nBuildStep := 0;
        Build := TRUE;
        
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExecutionRoute" Id="{6a4eba19-6c0e-4358-a0ad-58b76747b17e}">
      <Declaration><![CDATA[PROPERTY ExecutionRoute : E_ExecutionRoute]]></Declaration>
      <Get Name="Get" Id="{d7d2ba43-db8b-4ed8-951b-8e6102f5a71e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecutionRoute := E_ExecutionRoute.eGCode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <LineIds Name="FB_NCICimasa_SampleBox">
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_NCICimasa_SampleBox.Build">
      <LineId Id="2913" Count="41" />
      <LineId Id="11" Count="0" />
    </LineIds>
    <LineIds Name="FB_NCICimasa_SampleBox.ExecutionRoute.Get">
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>