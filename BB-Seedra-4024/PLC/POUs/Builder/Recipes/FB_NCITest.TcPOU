        _aGCodeBuffer[279] := 'N277 G03 X20 Y0 Q1=-2970. I20 F1549.7$N';
        _aGCodeBuffer[280] := 'N278 G01 X400 F3763.2$N';
        _aGCodeBuffer[281] := 'N279 G03 X420 Y20 Q1=-2880. J20 F1549.7$N';
        _aGCodeBuffer[282] := 'N280 G01 Y277 F3763.2$N';
        _aGCodeBuffer[283] := 'N281 G03 X400 Y297 Q1=-2790. I-20 F1549.7$N';
        _aGCodeBuffer[284] := 'N282 G01 Z22 F600$N';
        
        _nLinesToWrite := 284; 
        
        // Czyszczenie reszty bufora
        FOR i := (_nLinesToWrite + 1) TO 500 DO 
            _aGCodeBuffer[i] := '';
        END_FOR
        
        nBuildStep := 10;

    10:
        IF THIS^.WriteGCodeFile('TangentialCut.nc') THEN
            ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'Generator: Zapisano plik TangentialCut.nc', '');
            nBuildStep := 1000;
        END_IF

    1000:
        _Busy := FALSE;
        _Done := TRUE; 
        nBuildStep := 0;
        Build := TRUE;
        
END_CASE]]></ST>
      </Implementation>
    </Method>
