<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_NCITest" Id="{5dbcf7b2-1c2b-4fc5-ae62-5e1b9342eaeb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_NCITest EXTENDS FB_RecipeBase

]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Build" Id="{407edc7d-7aef-4048-8a91-20c5a7ce9a3f}">
      <Declaration><![CDATA[METHOD Build : BOOL
VAR
      i          : INT;
END_VAR

VAR_INST
    nBuildStep : INT;
    machineConfig : ST_GantryXYZ_Config;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Build := FALSE;

CASE nBuildStep OF
    0:
        _Busy := TRUE;
        _Done := FALSE;
        _Error := FALSE;
        _nLinesToWrite := 0;
        
        ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'Generator: Budowanie G-Code', '');
        
        THIS^.UpdateNestingLimits();
        IF NOT _Config.IsValid THEN
            ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'NCIBuilder: Walidacja nie przeszla! Ustawiam ERROR.', '');
            _Busy := FALSE;
            _Error := TRUE;
            Build := FALSE;
            RETURN;
        END_IF
        
        // --- BUFOR G-CODE ---
        _aGCodeBuffer[1]   := '(1001)$N';
        _aGCodeBuffer[2]   := 'N0 G01 Z22 F600$N';
        _aGCodeBuffer[3]   := 'N1 G01 Q1=7110. F72000';
		

        
        _nLinesToWrite := 3; 
        
        // Czyszczenie reszty bufora
        FOR i := (_nLinesToWrite + 1) TO 5 DO 
            _aGCodeBuffer[i] := '';
        END_FOR
        
        nBuildStep := 10;

    10:
        IF THIS^.WriteGCodeFile('\Hard Disk\NCITest.nc') THEN
            ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'Generator: Zapisano plik TangentialCut.nc', '');
            nBuildStep := 1000;
        END_IF

    1000:
        _Busy := FALSE;
        _Done := TRUE; 
        nBuildStep := 0;
        Build := TRUE;
        
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExecutionRoute" Id="{a6a1a916-e2d9-4ecd-aaea-35dbaf655dc7}">
      <Declaration><![CDATA[PROPERTY ExecutionRoute : E_ExecutionRoute]]></Declaration>
      <Get Name="Get" Id="{8cc88c4b-9acc-479d-a8db-4a8fec50b100}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecutionRoute := E_ExecutionRoute.eGCode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <LineIds Name="FB_NCITest">
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_NCITest.Build">
      <LineId Id="8124" Count="23" />
      <LineId Id="8180" Count="0" />
