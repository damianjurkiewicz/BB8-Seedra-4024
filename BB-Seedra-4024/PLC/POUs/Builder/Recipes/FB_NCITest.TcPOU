        _aGCodeBuffer[317] := 'N315 G01 Z16 F600$N';
        
        _nLinesToWrite := 317; 
        
        // Czyszczenie reszty bufora
        FOR i := (_nLinesToWrite + 1) TO 500 DO 
            _aGCodeBuffer[i] := '';
        END_FOR
        
        nBuildStep := 10;

    10:
        IF THIS^.WriteGCodeFile('TangentialCut.nc') THEN
            ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'Generator: Zapisano plik TangentialCut.nc', '');
            nBuildStep := 1000;
        END_IF

    1000:
        _Busy := FALSE;
        _Done := TRUE; 
        nBuildStep := 0;
        Build := TRUE;
        
END_CASE]]></ST>
