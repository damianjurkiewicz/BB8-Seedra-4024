<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_NCIMeina2_SampleBox" Id="{a4077330-6da6-413f-a705-3e06a762c716}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_NCIMeina2_SampleBox EXTENDS FB_RecipeBase

]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Build" Id="{35e58042-1596-4d98-b2a8-ce51c28b018b}">
      <Declaration><![CDATA[METHOD Build : BOOL
VAR
      i          : INT;
	  sRecipeName : STRING(255) := '\Hard Disk2\Meina2_SampleBox.nc';
END_VAR

VAR_INST
    nBuildStep : INT;
    machineConfig : ST_GantryXYZ_Config;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Build := FALSE;

CASE nBuildStep OF
    0:
        _Busy := TRUE;
        _Done := FALSE;
        _Error := FALSE;
        
        _Config.GCodePath := sRecipeName; 
        
        ADSLOGSTR(ADSLOG_MSGTYPE_HINT, CONCAT('Builder: Skonfigurowano gotowy plik G-Code: ', sRecipeName), '');
        
        nBuildStep := 1000;

    1000:
        _Busy := FALSE;
        _Done := TRUE; 
        nBuildStep := 0;
        Build := TRUE;
        
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExecutionRoute" Id="{3da0d898-d982-4548-8e68-e062b575b330}">
      <Declaration><![CDATA[PROPERTY ExecutionRoute : E_ExecutionRoute]]></Declaration>
      <Get Name="Get" Id="{054dbd75-ee81-49d9-bf90-24228ef6af44}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecutionRoute := E_ExecutionRoute.eGCode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <LineIds Name="FB_NCIMeina2_SampleBox">
      <LineId Id="9" Count="0" />
    </LineIds>
