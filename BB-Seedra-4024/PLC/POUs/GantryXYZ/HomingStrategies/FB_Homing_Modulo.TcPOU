      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FB_Homing_Modulo.HomingVelocity.Get">
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FB_Homing_Modulo.HomingVelocity.Set">
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>