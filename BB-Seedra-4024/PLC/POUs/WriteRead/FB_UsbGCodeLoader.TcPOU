<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_UsbGCodeLoader" Id="{cad01909-dd71-4c8a-b0fa-1b12de1a4b2f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_UsbGcodeLoader EXTENDS FB_CyclicFB
VAR_IN_OUT
    HMI              : ST_UsbGcodeLoader_HMI;
    RecipeConfig     : ST_RecipeBuilder_Config; 
END_VAR
VAR_OUTPUT
    bUsbPresent      : BOOL; // Zamiast Erroru, po prostu flaga obecności
END_VAR
VAR
    fbFindFile       : FB_EnumFindFileList;
    stFindFile       : ST_FindFileEntry;
    nStep            : INT;
    iFileCount       : INT;
    sUsbPath         : STRING(255) := '\Hard Disk2\*.nc'; 

    _Done            : BOOL; 
         
    _RecipeGCodeUSB  : I_RecipeBuilder;
    _bResetChannelReq: BOOL;
    
    fbScanTimer      : TON;
    aTempFileList    : ARRAY [0..30] OF STRING(255);
END_VAR
VAR_INPUT
    bLocked : BOOL; // TRUE, gdy maszyna nie jest w Idle/Stopped/Aborted
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Busy" Id="{2de0bbb7-214f-46df-a714-1666a4e29b84}">
      <Declaration><![CDATA[PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{2223317d-ce82-4697-b86c-f23673daabb7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{1def1362-a956-4aa0-beb0-f33c66b1084f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Busy := Busy;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="CyclicLogic" Id="{c00c8392-d673-4860-a014-1a09b118b28a}">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
VAR_INST
    iLastSelectedFile : INT := -1;
    bInitDone         : BOOL;
    bSelectionPending : BOOL;
    sSelectedName     : STRING(255);
    nEmptyScans       : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// 0. Pierwszy cykl: domyślny indeks z HMI to jeszcze nie jest świadomy wybór użytkownika
IF NOT bInitDone THEN
    iLastSelectedFile := HMI.iSelectedFile;
    bInitDone := TRUE;
END_IF

// 1. Użytkownik zmienił wybór (reagujemy tylko na zmianę indeksu, nie na migotanie zawartości)
IF HMI.iSelectedFile <> iLastSelectedFile THEN
    iLastSelectedFile := HMI.iSelectedFile;
    bSelectionPending := TRUE;
END_IF

// 2. Zastosuj wybór dopiero, gdy skaner USB w tle nie pracuje (nStep = 0) oraz maszyna jest zatrzymana (NOT bLocked)
IF bSelectionPending AND nStep = 0 AND NOT bLocked THEN
    IF HMI.iSelectedFile < 0 OR HMI.iSelectedFile > 30 THEN
        bSelectionPending := FALSE;                     // Zły indeks, ignoruj
    ELSIF _RecipeGCodeUSB <> 0 THEN                     // Czekaj, jeśli builder nie jest jeszcze wstrzyknięty
        IF LEN(HMI.aFileList[HMI.iSelectedFile]) > 0 THEN
            sSelectedName := HMI.aFileList[HMI.iSelectedFile];
            RecipeConfig.GCodePath := CONCAT('\Hard Disk2\', sSelectedName);
            _RecipeGCodeUSB.Config := RecipeConfig;
            _RecipeGCodeUSB.Build();
            ADSLOGSTR(ADSLOG_MSGTYPE_HINT, 'USB loader: wybrano plik %s', sSelectedName);
        END_IF
        bSelectionPending := FALSE;
    END_IF
END_IF

// 3. Cykliczne skanowanie USB w tle co 3 sekundy
fbScanTimer(IN := (nStep = 0), PT := T#3S);
IF fbScanTimer.Q THEN
    _Busy := TRUE;
    _Done := FALSE;
    _Error := FALSE;
    nStep := 10;
END_IF

// 4. Maszyna stanów do skanowania katalogu
CASE nStep OF
    0: // IDLE
        ;
        
    10: // INIT - Czyszczenie tylko tablicy tymczasowej
        FOR iFileCount := 0 TO 30 DO
            aTempFileList[iFileCount] := '';
        END_FOR
        iFileCount := 0;
        fbFindFile(bExecute := FALSE);
        nStep := 20;

    20: // POBIERZ PIERWSZY PLIK
        fbFindFile(
            bExecute := TRUE, sPathName := sUsbPath, eCmd := eEnumCmd_First, 
            pFindList:= ADR(stFindFile), cbFindList:= SIZEOF(stFindFile));
                 
        IF NOT fbFindFile.bBusy THEN
            IF fbFindFile.bError THEN
                nStep := 999;
            ELSIF NOT fbFindFile.bEOE THEN 
                aTempFileList[iFileCount] := stFindFile.sFileName;
                iFileCount := iFileCount + 1;
                fbFindFile(bExecute := FALSE);
                nStep := 30;
            ELSE
                fbFindFile(bExecute := FALSE);
                nStep := 1000;
            END_IF
        END_IF

    30: // POBIERZ KOLEJNE PLIKI
        fbFindFile(
            bExecute := TRUE, eCmd := eEnumCmd_Next, 
            pFindList:= ADR(stFindFile), cbFindList:= SIZEOF(stFindFile));
                 
        IF NOT fbFindFile.bBusy THEN
            IF fbFindFile.bError THEN
                nStep := 999;
            ELSIF NOT fbFindFile.bEOE THEN 
                IF iFileCount <= 30 THEN
                    aTempFileList[iFileCount] := stFindFile.sFileName;
                    iFileCount := iFileCount + 1;
                END_IF
                fbFindFile(bExecute := FALSE);
            ELSE
                fbFindFile(bExecute := FALSE);
                nStep := 1000;
            END_IF
        END_IF

    999: // ERROR HANDLING
        IF nEmptyScans < 100 THEN nEmptyScans := nEmptyScans + 1; END_IF
        IF nEmptyScans >= 3 THEN bUsbPresent := FALSE; END_IF
        
        _Busy := FALSE;
        _Error := TRUE;
        nStep := 0;

    1000: // ZAKOŃCZONO SUKCESEM
        IF iFileCount = 0 THEN
            IF nEmptyScans < 100 THEN nEmptyScans := nEmptyScans + 1; END_IF
        ELSE
            nEmptyScans := 0;
        END_IF

        // Pustą listę (np. chwilowe zniknięcie dysku z winy CE) uznaj dopiero po 3 kolejnych pustych skanach
        IF iFileCount > 0 OR nEmptyScans >= 3 THEN
            HMI.aFileList := aTempFileList;
            bUsbPresent := (iFileCount > 0);
        END_IF
        
        // Zmienna RecipeConfig.GCodePath NIE jest już czyszczona tutaj!

        _Error := FALSE;
        _Done  := TRUE;
        _Busy  := FALSE;
        nStep  := 0;
END_CASE]]></ST>
      </Implementation>
    </Method>
