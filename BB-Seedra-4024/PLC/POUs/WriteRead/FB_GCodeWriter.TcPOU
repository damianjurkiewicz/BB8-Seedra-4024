<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_GCodeWriter" Id="{814fc841-fe69-402b-aca6-55be2e76aead}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCodeWriter EXTENDS FB_CyclicFB
VAR
    _RecipeBuilder  : I_RecipeBuilder; 
    iLinesCount     : INT;
    sLocalGCodePath : STRING(255) := '\Hard Disk\ActiveGCode.nc';
    
    nStep           : INT;
    iCurrentLine    : INT;
    
    fbFileOpen      : FB_FileOpen;
    fbFilePuts      : FB_FilePuts;
    fbFileClose     : FB_FileClose;
    hFile           : UINT;
    
    _Done           : BOOL; // Keep only _Done, remove _Busy and _Error
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="Busy" Id="{2e065f0d-799d-4eb5-b9d3-6e585d57eeec}">
      <Declaration><![CDATA[PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{52e2acbb-38db-4661-b5f3-a3d1a1c00456}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CyclicLogic" Id="{fdd8e1b8-f12d-4f4d-8675-f32f33382f79}">
      <Declaration><![CDATA[METHOD PUBLIC  CyclicLogic
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Wklej tutaj w pełni działającą implementację z FB_RecipeBase.WriteGCodeFile
CASE nStep OF
    0: // IDLE
        ;
    10: // Otwarcie pliku (FOPEN_MODEWRITE OR FOPEN_MODETEXT)
        fbFileOpen(bExecute := FALSE);
        fbFileOpen(
            sNetId := '', 
            sPathName := sLocalGCodePath, 
            nMode := FOPEN_MODEWRITE OR FOPEN_MODETEXT, 
            bExecute := TRUE
        );
        nStep := 20;
        
    20: // Czekamy na otwarcie
        fbFileOpen(bExecute := FALSE);
        IF NOT fbFileOpen.bBusy THEN
            IF fbFileOpen.bError THEN
                nStep := 999;
            ELSE
                hFile := fbFileOpen.hFile;
                iCurrentLine := 1;
                nStep := 30;
            END_IF
        END_IF
        
	30: // Zapis linijka po linijce
        IF iCurrentLine <= iLinesCount THEN
            fbFilePuts(bExecute := FALSE);
            fbFilePuts(
                sNetId   := '', 
                hFile    := hFile, 
                // POLIMORFIZM: Writer nie wie skąd pochodzi kod, 
                // po prostu prosi interfejs o kolejną linię:
                sLine    := _RecipeBuilder.GetGCodeLine(iCurrentLine), 
                bExecute := TRUE
            );
            nStep := 40;
        ELSE
            // Wszystko zapisane
            nStep := 50;
        END_IF
        
    40: // Czekamy na zapis linii
        fbFilePuts(bExecute := FALSE);
        IF NOT fbFilePuts.bBusy THEN
            IF fbFilePuts.bError THEN
                nStep := 999;
            ELSE
                iCurrentLine := iCurrentLine + 1;
                nStep := 30; // Wracamy do zapisu kolejnej linii
            END_IF
        END_IF
        
    50: // Zamknięcie pliku
        fbFileClose(bExecute := FALSE);
        fbFileClose(sNetId := '', hFile := hFile, bExecute := TRUE);
        nStep := 60;
        
    60: // Czekamy na zamknięcie
        fbFileClose(bExecute := FALSE);
        IF NOT fbFileClose.bBusy THEN
            IF fbFileClose.bError THEN
                nStep := 999;
            ELSE
                _Busy := FALSE;
                _Done := TRUE;
                nStep := 0;
            END_IF
        END_IF
        
    999: // ERROR
        _Error := TRUE;
        _Busy := FALSE;
        nStep := 0;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Done" Id="{b5db466a-493e-4d5e-957c-6fcff57130c8}">
      <Declaration><![CDATA[PROPERTY Done : BOOL]]></Declaration>
      <Get Name="Get" Id="{f97c63e0-dae0-4538-8e94-35d55b134262}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Done := _Done;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Error" Id="{fc885aed-347f-484a-8da7-5ac00f823ecc}">
      <Declaration><![CDATA[PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{8e7ad2f8-0559-47f1-8f47-390358cde98c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := _Error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Execute" Id="{227ff0bb-1075-40f8-9df9-42912fade186}">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR_INPUT
    Builder : I_RecipeBuilder; // Wstrzykiwanie przez interfejs
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Busy OR Builder = 0 THEN RETURN; END_IF

_RecipeBuilder := Builder;
iLinesCount    := _RecipeBuilder.GetLinesCount();

_Busy   := TRUE;
_Done   := FALSE;
_Error  := FALSE;
nStep   := 10;
Execute := TRUE;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_GCodeWriter">
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_GCodeWriter.Busy.Get">
      <LineId Id="2" Count="0" />
    </LineIds>
