      <LineId Id="6" Count="25" />
      <LineId Id="79" Count="14" />
      <LineId Id="45" Count="33" />
      <LineId Id="4" Count="0" />
    </LineIds>
    <LineIds Name="FB_GCodeWriter.Done.Get">
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FB_GCodeWriter.Error.Get">
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FB_GCodeWriter.Execute">
      <LineId Id="28" Count="8" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>